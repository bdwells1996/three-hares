{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "three-hares-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://threeharestattoobtn.com",
    "CONTACT_FROM_EMAIL": "Three Hares <enquiries@threeharestattoobtn.com>",
    "CONTACT_TO_EMAIL": "threeharestattoobtn@gmail.com",
    "ALERT_TO_EMAIL": "bdwells1996@gmail.com",
    "SANITY_PROJECT_ID": "rp373id5",
    "SANITY_DATASET": "production",
    "SANITY_API_VERSION": "2026-05-16"
  },
  "unsafe": {
    "bindings": [
      {
        "name": "CONTACT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "2001",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  }
}
